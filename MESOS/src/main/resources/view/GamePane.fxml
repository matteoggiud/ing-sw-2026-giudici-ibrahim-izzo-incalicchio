<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.polimi.ingsw.client.view.gui.controllers.GameController"
            prefWidth="1100.0" prefHeight="700.0">

    <top>
        <HBox spacing="8" alignment="TOP_LEFT" style="-fx-padding: 10;">
            <VBox spacing="8">
                <Label text="Game" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label fx:id="eraLabel" text="Era: -"/>
                <Label fx:id="turnLabel" text="Turn: -"/>
                <Label fx:id="gameInfoLabel" text=""/>
                <Button fx:id="seeResults" text="See Results" onAction="#handleSeeResults" visible="false" managed="false" style="-fx-font-size: 14px; -fx-padding: 8px 18px;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="leaveGameButton" text="Leave Game" onAction="#handleLeaveGame" style="-fx-font-size: 14px; -fx-padding: 8px 18px;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <VBox spacing="18"
                  style="-fx-padding: 10;"
                  fillWidth="true">

                <Label text="Board" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <!-- UPPER ROW -->
                <ScrollPane fitToHeight="true"
                            fitToWidth="true"
                            hbarPolicy="AS_NEEDED"
                            vbarPolicy="NEVER"
                            prefViewportHeight="175"
                            minViewportHeight="175">
                    <HBox fx:id="upperRow"
                          spacing="8"
                          alignment="CENTER_LEFT"
                          minHeight="165"/>
                </ScrollPane>

                <!-- MIDDLE ROW: turn order + offer track -->
                <HBox spacing="18"
                      alignment="CENTER_LEFT"
                      minHeight="175"
                      prefHeight="175">

                    <HBox fx:id="turnOrderBox"
                          alignment="CENTER"
                          minWidth="115"
                          prefWidth="115"
                          minHeight="165"/>

                    <ScrollPane fitToHeight="true"
                                fitToWidth="true"
                                hbarPolicy="AS_NEEDED"
                                vbarPolicy="NEVER"
                                HBox.hgrow="ALWAYS"
                                prefViewportHeight="175"
                                minViewportHeight="175">
                        <HBox fx:id="offerTrack"
                              spacing="8"
                              alignment="CENTER_LEFT"
                              minHeight="165"/>
                    </ScrollPane>
                </HBox>

                <!-- LOWER ROW -->
                <ScrollPane fitToHeight="true"
                            fitToWidth="true"
                            hbarPolicy="AS_NEEDED"
                            vbarPolicy="NEVER"
                            prefViewportHeight="175"
                            minViewportHeight="175">
                    <HBox fx:id="lowerRow"
                          spacing="8"
                          alignment="CENTER_LEFT"
                          minHeight="165"/>
                </ScrollPane>

                <TextArea fx:id="boardArea"
                          editable="false"
                          wrapText="true"
                          prefRowCount="4"
                          visible="false"
                          managed="false"/>
            </VBox>
        </ScrollPane>
    </center>


    <!-- PLAYER PANELS alla destra (usa la tua playersListView già presente) -->
    <right>
        <VBox spacing="10" style="-fx-padding: 10;" >
            <Label text="Players" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <ListView fx:id="playersListView" maxHeight="600.0"/>
        </VBox>
    </right>

    <bottom>
        <VBox>
            <Label text="Your deck"/>
            <ScrollPane fitToHeight="true" fitToWidth="true" prefViewportHeight="200">
                <HBox fx:id="myDeckBox" alignment="CENTER_LEFT"/>
            </ScrollPane>
        </VBox>
    </bottom>

</BorderPane>