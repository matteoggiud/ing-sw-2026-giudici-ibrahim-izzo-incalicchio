<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.polimi.ingsw.client.view.gui.controllers.GameController"
            prefWidth="1100.0" prefHeight="700.0">

    <top>
        <VBox spacing="8" style="-fx-padding: 10;">
            <Label text="Game" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label fx:id="eraLabel" text="Era: -"/>
            <Label fx:id="turnLabel" text="Turn: -"/>
            <Label fx:id="gameInfoLabel" text=""/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label text="Board" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <TextArea fx:id="boardArea" editable="false" wrapText="true" prefRowCount="18"/>
        </VBox>
    </center>

    <!-- PLAYER PANELS: usa una ListView di PlayerInfoDTO con cellFactory personalizzata -->
    <right>
        <VBox spacing="10" style="-fx-padding: 10;" prefWidth="420.0">
            <Label text="Players" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <ListView fx:id="playersListView" prefHeight="600.0"/>
        </VBox>
    </right>

</BorderPane>