<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="gameRoot"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.client.view.gui.controllers.GameController"
           prefWidth="1600.0"
           prefHeight="900.0"
           stylesheets="@../styles/game.css"
           styleClass="game-root">

    <ImageView fx:id="backgroundImage"
               smooth="true"
               preserveRatio="false">
        <image>
            <Image url="@../assets/backgrounds/gameBg.PNG"/>
        </image>
    </ImageView>

    <Pane fx:id="gameOverlay"
          pickOnBounds="false">

        <Label fx:id="eraLabel"
               text="Era: -"
               alignment="CENTER"
               styleClass="game-info-label"/>

        <Label fx:id="turnLabel"
               text="Turn: -"
               alignment="CENTER"
               styleClass="game-info-label"/>

        <Label fx:id="gameInfoLabel"
               text=""
               alignment="CENTER"
               styleClass="game-info-label"/>

        <Button fx:id="seeResults"
                text="See Results"
                onAction="#handleSeeResults"
                visible="false"
                managed="false"
                styleClass="game-button"/>

        <Button fx:id="leaveGameButton"
                text="Leave"
                onAction="#handleLeaveGame"
                styleClass="game-button, danger"/>

        <ScrollPane fx:id="upperRowArea"
                    fitToHeight="true"
                    fitToWidth="true"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="NEVER"
                    styleClass="game-scroll">
            <HBox fx:id="upperRow"
                  spacing="8"
                  alignment="CENTER_LEFT"
                  styleClass="game-card-row"/>
        </ScrollPane>

        <HBox fx:id="middleRowArea"
              spacing="12"
              alignment="CENTER_LEFT"
              styleClass="game-row-wrapper">

            <HBox fx:id="turnOrderBox"
                  alignment="CENTER"
                  minWidth="112"
                  prefWidth="112"
                  maxWidth="112"/>

            <ScrollPane fitToHeight="true"
                        fitToWidth="true"
                        hbarPolicy="AS_NEEDED"
                        vbarPolicy="NEVER"
                        HBox.hgrow="ALWAYS"
                        styleClass="game-scroll">
                <HBox fx:id="offerTrack"
                      spacing="8"
                      alignment="CENTER_LEFT"
                      styleClass="game-card-row"/>
            </ScrollPane>
        </HBox>

        <ScrollPane fx:id="lowerRowArea"
                    fitToHeight="true"
                    fitToWidth="true"
                    hbarPolicy="AS_NEEDED"
                    vbarPolicy="NEVER"
                    styleClass="game-scroll">
            <HBox fx:id="lowerRow"
                  spacing="8"
                  alignment="CENTER_LEFT"
                  styleClass="game-card-row"/>
        </ScrollPane>

        <VBox fx:id="statsPanel"
              spacing="10"
              styleClass="game-stats-panel">
            <Label text="Players"
                   alignment="CENTER"
                   maxWidth="Infinity"
                   styleClass="game-section-title"/>

            <ListView fx:id="playersListView"
                      VBox.vgrow="ALWAYS"
                      styleClass="game-list"/>

            <Label text="Your deck"
                   alignment="CENTER"
                   maxWidth="Infinity"
                   styleClass="game-section-title"/>

            <ScrollPane fitToHeight="true"
                        fitToWidth="true"
                        hbarPolicy="AS_NEEDED"
                        vbarPolicy="NEVER"
                        prefViewportHeight="145"
                        styleClass="game-scroll">
                <HBox fx:id="myDeckBox"
                      spacing="8"
                      alignment="CENTER_LEFT"
                      styleClass="game-card-row"/>
            </ScrollPane>
        </VBox>

        <TextArea fx:id="boardArea"
                  editable="false"
                  wrapText="true"
                  visible="false"
                  managed="false"/>
    </Pane>
</StackPane>
