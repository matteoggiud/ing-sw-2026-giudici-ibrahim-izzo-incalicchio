<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.client.view.gui.controllers.AuthController"
           prefWidth="1600.0"
           prefHeight="900.0"
           stylesheets="@../styles/auth.css"
           styleClass="auth-root">

    <GridPane maxWidth="Infinity" maxHeight="Infinity">
        <columnConstraints>
            <ColumnConstraints percentWidth="53.0"/>
            <ColumnConstraints percentWidth="29.0"/>
            <ColumnConstraints percentWidth="18.0"/>
        </columnConstraints>

        <rowConstraints>
            <RowConstraints percentHeight="39.0"/>
            <RowConstraints percentHeight="42.0"/>
            <RowConstraints percentHeight="19.0"/>
        </rowConstraints>

        <VBox GridPane.columnIndex="1"
              GridPane.rowIndex="1"
              alignment="CENTER_LEFT"
              maxWidth="Infinity"
              maxHeight="Infinity"
              spacing="14.0"
              styleClass="auth-panel">

            <Label text="Accesso al villaggio" styleClass="auth-heading"/>
            <Label text="Inserisci le credenziali per entrare in MESOS"
                   styleClass="auth-subtitle"
                   wrapText="true"/>

            <TextField fx:id="nicknameField"
                       promptText="Nickname"
                       onKeyPressed="#handleKeyPress"
                       maxWidth="Infinity"
                       styleClass="auth-field"/>

            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           onKeyPressed="#handleKeyPress"
                           maxWidth="Infinity"
                           styleClass="auth-field"/>

            <Label fx:id="messageLabel"
                   text=""
                   visible="false"
                   managed="false"
                   maxWidth="Infinity"
                   styleClass="auth-message"/>

            <HBox alignment="CENTER" spacing="12.0" styleClass="auth-actions">
                <Button id="loginButton"
                        text="Login"
                        onAction="#handleLogin"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        styleClass="auth-button"/>

                <Button id="registerButton"
                        text="Register"
                        onAction="#handleRegistration"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        styleClass="auth-button"/>
            </HBox>
        </VBox>
    </GridPane>
</StackPane>
