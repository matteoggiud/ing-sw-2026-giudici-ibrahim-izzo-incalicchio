<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.client.view.gui.controllers.AuthController">

    <VBox alignment="CENTER" layoutX="150" layoutY="100" prefHeight="212.0" prefWidth="270.0" spacing="20">
        <TextField fx:id="nicknameField" promptText="Nickname" onKeyPressed="#handleKeyPress" />
        <PasswordField fx:id="passwordField" promptText="Password" onKeyPressed="#handleKeyPress" />

        <Label fx:id="messageLabel" text="" />

        <HBox alignment="CENTER" spacing="10">
            <Button onAction="#handleLogin" text="Login" />
            <Button onAction="#handleRegistration" text="Register" />
        </HBox>
    </VBox>

</AnchorPane>
