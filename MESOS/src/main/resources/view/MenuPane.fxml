<AnchorPane prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.client.view.gui.controllers.MenuController">

    <!-- HBox principale con 3 colonne -->
    <HBox spacing="20" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">

        <!-- ===== COLONNA SINISTRA: AVAILABLE GAMES ===== -->
        <VBox spacing="10" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size:14; -fx-font-weight:bold;" text="Available Games" />

            <!-- ListView per i giochi disponibili -->
            <ListView fx:id="gamesListView" prefHeight="220.0" />

            <!-- HBox con il pulsante Join (visibile solo quando un gioco è selezionato) -->
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <Button fx:id="refreshButton" onAction="#handleRefresh" style="-fx-font-size:11;" text="Refresh" />
                <Button fx:id="joinButton" disable="true" onAction="#handleJoin" style="-fx-font-size:11; -fx-padding: 8px 20px;" text="Join" />
            </HBox>
        </VBox>

        <!-- ===== COLONNA CENTRO: CREATE/QUIT ===== -->
        <VBox alignment="CENTER" maxWidth="200" spacing="20" HBox.hgrow="ALWAYS" translateY="-100.0">
            <Label alignment="CENTER" style="-fx-font-size:14; -fx-font-weight:bold;" text="Menu" />

            <!-- Sezione Create Game -->
            <VBox spacing="10" style="-fx-border-color: #AAAAAA; -fx-border-radius: 5; -fx-padding: 15; -fx-border-width: 2;">
                <Label style="-fx-font-size:12; -fx-font-weight:bold;" text="Create New Game" />

                <Label style="-fx-font-size:11;" text="Number of Players:" />
                <ChoiceBox fx:id="choiceExpectedNumPlayers" maxWidth="Infinity">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <Integer fx:value="2" />
                            <Integer fx:value="3" />
                            <Integer fx:value="4" />
                            <Integer fx:value="5" />
                        </FXCollections>
                    </items>
                </ChoiceBox>

                <Button fx:id="createButton" onAction="#handleCreate" style="-fx-font-size:12; -fx-padding: 10px;" text="✓ Create Game" />
            </VBox>

            <Separator style="-fx-padding: 10;" />

            <!-- Pulsante Quit -->
            <Button fx:id="quitButton" onAction="#handleQuit" style="-fx-font-size:12; -fx-padding: 10px; -fx-text-fill: white; -fx-background-color: #f44336;" text="✕ Quit" />
        </VBox>

        <!-- ===== COLONNA DESTRA: RANKINGS ===== -->
        <VBox spacing="10" style="-fx-border-color: #2196F3; -fx-border-radius: 5; -fx-padding: 10; -fx-border-width: 2;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size:14; -fx-font-weight:bold;" text="Player Rankings" />

            <!-- Sezione filtro -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label style="-fx-font-size:11;" text="Players:" />
                <ChoiceBox fx:id="choiceNumPlayersForRankings" maxWidth="Infinity" onAction="#handleRankings">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <Integer fx:value="2" />
                            <Integer fx:value="3" />
                            <Integer fx:value="4" />
                            <Integer fx:value="5" />
                        </FXCollections>
                    </items>
                </ChoiceBox>
            </HBox>

            <!-- ListView dei rankings -->
            <ListView fx:id="rankingsListView" prefHeight="220.0" />

            <!-- Pulsante per refresh manuale -->
            <Button fx:id="rankingsRefreshButton" style="-fx-font-size:11;" text="Refresh Rankings" onAction="#handleRankings" />
        </VBox>

    </HBox>
</AnchorPane>
