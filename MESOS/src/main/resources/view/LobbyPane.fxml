<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.polimi.ingsw.client.view.gui.controllers.LobbyController"
            prefHeight="400.0" prefWidth="600.0">

    <VBox spacing="12"
          alignment="CENTER"
          layoutX="20.0" layoutY="20.0"
          AnchorPane.topAnchor="20.0"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0"
          AnchorPane.bottomAnchor="20.0">

        <Label text="Lobby" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <Label fx:id="gameIdLabel" text="Game ID: -"/>
        <Label fx:id="playersCountLabel" text="Players: -"/>
        <Label text="Players in lobby:"/>

        <ListView fx:id="playersListView" prefHeight="180.0" prefWidth="250.0"/>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="leaveButton" text="Leave" onAction="#handleLeave"/>
        </HBox>

    </VBox>
</AnchorPane>