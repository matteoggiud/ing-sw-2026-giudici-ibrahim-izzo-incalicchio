<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="lobbyRoot"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.client.view.gui.controllers.LobbyController"
           prefWidth="1600.0"
           prefHeight="900.0"
           stylesheets="@../styles/lobby.css"
           styleClass="lobby-root">

    <ImageView fx:id="backgroundImage"
               smooth="true"
               preserveRatio="false">
        <image>
            <Image url="@../assets/backgrounds/lobbyBg.png"/>
        </image>
    </ImageView>

    <Pane fx:id="lobbyOverlay"
          pickOnBounds="false">

        <Label fx:id="lobbyTitleLabel"
               text="Lobby"
               alignment="CENTER"
               styleClass="lobby-title"/>

        <Label fx:id="gameIdLabel"
               text="Game ID: -"
               alignment="CENTER"
               styleClass="lobby-info"/>

        <Label fx:id="playersCountLabel"
               text="Players: -"
               alignment="CENTER"
               styleClass="lobby-info"/>

        <Label fx:id="playersTitleLabel"
               text="Players in lobby"
               alignment="CENTER"
               styleClass="lobby-section-title"/>

        <ListView fx:id="playersListView"
                  styleClass="lobby-list"/>

        <Button fx:id="leaveButton"
                text="Leave"
                onAction="#handleLeave"
                styleClass="lobby-button, danger"/>
    </Pane>
</StackPane>